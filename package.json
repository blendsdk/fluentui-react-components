{
  "name": "fluentui-react-components-monorepo",
  "version": "0.3.0",
  "private": true,
  "description": "Monorepo for custom React components built on Fluent UI v9",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=12.8.0 <13"
  },
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test --concurrency=4",
    "test:watch": "turbo run test:watch",
    "test:browser": "pnpm --filter @blendsdk/fluentui-react-components test:browser",
    "test:browser:all": "pnpm --filter @blendsdk/fluentui-react-components test:browser:all",
    "test:perf": "pnpm --filter @blendsdk/fluentui-react-components test:perf",
    "type-check": "turbo run type-check",
    "storybook": "turbo run storybook",
    "storybook:build": "turbo run storybook:build",
    "clean": "turbo run clean && rm -rf .turbo",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "skill:check": "node scripts/check-skill.mjs",
    "skills:sync": "node scripts/sync-skills.mjs",
    "skills:check": "node scripts/sync-skills.mjs && skills add ./packages/react-components --list",
    "pack:check": "node scripts/check-pack.mjs",
    "verify": "pnpm format:check && pnpm skill:check && pnpm type-check && pnpm build && pnpm test",
    "lockstep": "lockstep",
    "lockstep:sync": "lockstep sync",
    "lockstep:version:auto": "lockstep version --type auto --ci --no-changelog",
    "lockstep:version:patch": "lockstep version --type patch --ci --no-changelog",
    "lockstep:version:minor": "lockstep version --type minor --ci --no-changelog",
    "lockstep:version:major": "lockstep version --type major --ci --no-changelog",
    "lockstep:publish:latest": "lockstep publish --tag latest --git-push && git push --tags",
    "lockstep:publish:next": "lockstep publish --tag next --git-push && git push --tags"
  },
  "devDependencies": {
    "@blendsdk/lockstep": "^1.3.0",
    "prettier": "^3.9.10",
    "skills": "1.7.2",
    "turbo": "^2.11.8"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blendsdk/fluentui-react-components.git"
  },
  "keywords": [
    "fluentui",
    "react",
    "components",
    "design-system",
    "monorepo"
  ]
}
