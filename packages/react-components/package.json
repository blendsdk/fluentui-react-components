{
  "name": "@blendsdk/fluentui-react-components",
  "version": "0.5.0",
  "description": "Custom React components built on Fluent UI v9 in the Fluent component pattern",
  "type": "module",
  "license": "MIT",
  "author": "TrueSoftware B.V.",
  "sideEffects": false,
  "engines": {
    "node": ">=22.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "skills"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blendsdk/fluentui-react-components.git",
    "directory": "packages/react-components"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@tanstack/react-virtual": "3.14.21"
  },
  "scripts": {
    "build": "node ../../scripts/sync-skills.mjs && vite build && tsc -p tsconfig.build.json",
    "skills:sync": "node ../../scripts/sync-skills.mjs",
    "prepack": "node ../../scripts/sync-skills.mjs",
    "dev": "vite build --watch",
    "clean": "rm -rf dist storybook-static",
    "test": "vitest run --reporter=verbose",
    "test:watch": "vitest watch --reporter=verbose",
    "test:coverage": "vitest run --coverage",
    "test:browser": "vitest run --config vitest.browser.config.ts --reporter=verbose",
    "test:browser:all": "vitest run --config vitest.browser-matrix.config.ts --reporter=verbose",
    "test:perf": "vitest run --config vitest.perf.config.ts --reporter=verbose",
    "type-check": "tsc --noEmit",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build -o storybook-static"
  },
  "peerDependencies": {
    "@fluentui/react-components": "^9.0.0",
    "@fluentui/react-datepicker-compat": "^0.6.0",
    "@fluentui/react-icons": "^2.0.0",
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.55.0"
  },
  "devDependencies": {
    "@fluentui/react-components": "^9.74.9",
    "@fluentui/react-datepicker-compat": "^0.6.39",
    "@fluentui/react-icons": "^2.0.344",
    "@storybook/addon-a11y": "^10.6.2",
    "@storybook/addon-docs": "^10.6.2",
    "@storybook/react-vite": "^10.6.2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser": "5.0.5",
    "@vitest/browser-playwright": "5.0.5",
    "@vitest/coverage-v8": "5.0.5",
    "jsdom": "^30.1.3",
    "playwright": "1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.90.0",
    "storybook": "^10.6.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "5.0.5"
  }
}
